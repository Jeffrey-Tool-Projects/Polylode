<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A CUE4Parse checkout at the commit README.md names, with cue4parse_wuthering_waves.patch applied. -->
    <CUE4ParseRoot Condition="'$(CUE4ParseRoot)' == ''">$(MSBuildProjectDirectory)/CUE4Parse</CUE4ParseRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.13" />
    <ProjectReference Include="$(CUE4ParseRoot)/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseRoot)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>
</Project>
